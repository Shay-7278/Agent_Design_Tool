<?xml version="1.0"?>
<package format="3">
  <name>abb_irb4600_gazebo</name>
  <version>0.1.0</version>
  <description>Gazebo control integration for the dual ABB IRB4600 workcell.</description>

  <maintainer email="an7278@princeton.edu">Shay-7278</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>abb_irb4600_workcell_description</depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>ros2_control</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
