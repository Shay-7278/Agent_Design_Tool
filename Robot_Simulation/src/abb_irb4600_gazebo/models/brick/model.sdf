<?xml version="1.0"?>
<sdf version="1.9">
  <model name="brick">
    <static>false</static>
    <link name="brick_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <!-- Dimensions and density match physics_check/pc/params.py defaults:
             190 x 90 x 57 mm, density 700 kg/m^3. -->
        <mass>0.68229</mass>
        <inertia>
          <!-- Solid rectangular box inertia about its centre of mass. -->
          <ixx>0.0006452757675</ixx>
          <iyy>0.0022372857675</iyy>
          <izz>0.0025131015</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.190 0.090 0.057</size></box></geometry>
        <surface>
          <!-- Match physics_check/pc/params.py mu=0.84. -->
          <friction><ode><mu>0.84</mu><mu2>0.84</mu2></ode></friction>
          <contact><ode><kp>1e8</kp><kd>10000</kd><max_vel>0</max_vel><min_depth>0.0001</min_depth></ode></contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.190 0.090 0.057</size></box></geometry>
        <material><ambient>0.72 0.25 0.08 1</ambient><diffuse>0.72 0.25 0.08 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
