<?xml version="1.0"?>
<sdf version="1.9">
  <model name="brick_half">
    <static>false</static>
    <link name="brick_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <!-- 95 x 90 x 57 mm at the same 700 kg/m^3 density as the full brick. -->
        <mass>0.341145</mass>
        <inertia>
          <!-- Solid rectangular box inertia about its centre of mass. -->
          <ixx>0.00032263788375</ixx>
          <iyy>0.0003489344775</iyy>
          <izz>0.00048684234375</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.095 0.090 0.057</size></box></geometry>
        <surface>
          <friction><ode><mu>0.84</mu><mu2>0.84</mu2></ode></friction>
          <contact><ode><kp>1e8</kp><kd>10000</kd><max_vel>0</max_vel><min_depth>0.0001</min_depth></ode></contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.095 0.090 0.057</size></box></geometry>
        <material><ambient>0.72 0.25 0.08 1</ambient><diffuse>0.72 0.25 0.08 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
