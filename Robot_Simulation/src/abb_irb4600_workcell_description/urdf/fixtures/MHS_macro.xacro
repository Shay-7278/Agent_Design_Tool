<?xml version="1.0" encoding="UTF-8"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:property name="MHS_gripper_closed_distance" value="0.0127" />
  <xacro:property name="MHS_gripper_open_distance" value="0.2127" />
  <xacro:property name="finger_stroke" value="${(MHS_gripper_open_distance - MHS_gripper_closed_distance)/2}" />

  <xacro:macro name="material_MHS_white">
    <material name="MHS_white">
      <color rgba="0.9607843 0.9450980 0.9137255 1"/>
    </material>
  </xacro:macro>

  <xacro:macro name="material_handling_station" params="
    prefix:=MHS_
    parent:=world
    xyz
    rpy
    ">

    <!--links-->
    <link name="${prefix}base">
      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="2.0"/>
        <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://abb_irb4600_workcell_description/meshes/visual/fixtures/MHS_base.stl"/>
        </geometry>
        <origin xyz="0 0 0"/>
        <xacro:material_MHS_white />
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://abb_irb4600_workcell_description/meshes/collision/fixtures/MHS_base.stl"/>
        </geometry>
        <origin xyz="0 0 0"/>
      </collision>
    </link>

    <link name="${prefix}fingers_right">
      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.2"/>
        <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://abb_irb4600_workcell_description/meshes/visual/fixtures/MHS_fingers_right.stl"/>
        </geometry>
        <origin xyz="0 0 0"/>
        <xacro:material_MHS_white />
      </visual>
    </link>

    <link name="${prefix}fingers_left">
      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.2"/>
        <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://abb_irb4600_workcell_description/meshes/visual/fixtures/MHS_fingers_left.stl"/>
        </geometry>
        <origin xyz="0 0 0"/>
        <xacro:material_MHS_white />
      </visual>
    </link>

    <!--joints-->
    <joint name="${prefix}base_fixed_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}base"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <!-- Temporary addition. TODO: make each gripper an individual joint, or make configurable -->
    <link name="${prefix}gripper_axis"/>
    <joint name="${prefix}gripper_axis_fixed_joint" type="fixed">
      <parent link="${prefix}base"/>
      <child link="${prefix}gripper_axis"/>
      <origin xyz="1.313939269 0.279761276 0.635263929" rpy="-0.000008511 0.000012383 0.006331132"/>
    </joint>

    <joint name="${prefix}left_finger_joint" type="prismatic">
      <parent link="${prefix}gripper_axis"/>
      <child link="${prefix}fingers_left"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0" upper="${finger_stroke}" effort="10" velocity="0.1"/>
      <dynamics damping="1.0" friction="0.1"/>
    </joint>

    <joint name="${prefix}right_finger_joint" type="prismatic">
      <parent link="${prefix}gripper_axis"/>
      <child link="${prefix}fingers_right"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="0" upper="${finger_stroke}" effort="10" velocity="0.1"/>
      <mimic joint="${prefix}left_finger_joint" multiplier="1.0" offset="0.0"/>
      <dynamics damping="1.0" friction="0.1"/>
    </joint>
  </xacro:macro>
</robot>
