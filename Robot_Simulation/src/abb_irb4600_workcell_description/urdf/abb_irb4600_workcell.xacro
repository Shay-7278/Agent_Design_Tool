<?xml version="1.0" encoding="UTF-8"?>

<robot name="abb_irb4600_workcell" xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:include filename="$(find abb_irb4600_workcell_description)/urdf/abb_irb4600_workcell_macro.xacro"/>

  <!-- LL carries the SCHUNK brick gripper; RR remains a bare visible robot. -->
  <xacro:arg name="tool_ll" default="schunk_pgf_100"/>

  <link name="world"/>
  <xacro:abb_irb4600_workcell
    parent="world"
    tool_ll="$(arg tool_ll)"
  />

</robot>
